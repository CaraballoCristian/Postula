# Secreto JWT (OBLIGATORIO en producción; el server falla si no está definido)
JWT_SECRET=cambia-este-secreto

# Rate limiting por IP (valores por defecto)
AUTH_RATE_WINDOW_MIN=15
AUTH_LOGIN_RATE_MAX=10
AUTH_REGISTER_RATE_MAX=20

# Puerto del servidor
PORT=3000

# Ruta al cliente compilado (la define el Dockerfile; no tocar en producción)
CLIENT_DIST=/app/public

# Ruta alternativa a la base SQLite (opcional; por defecto server/data/postulatool.sqlite)
# POSTULATOOL_DB=/app/data/postulatool.sqlite
