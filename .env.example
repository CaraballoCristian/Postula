# Copia este archivo a `.env` y completá los valores reales (el `.env` no se sube al repo).
JWT_SECRET=cambia-este-secreto

# Rate limiting específico de auth (ventana en minutos / máximos por IP).
AUTH_RATE_WINDOW_MIN=15
AUTH_LOGIN_RATE_MAX=10
AUTH_REGISTER_RATE_MAX=20

# Orígenes permitidos para CORS (separados por coma). Si no se define, quedan los
# de desarrollo local (Angular dev server y el contenedor).
CORS_ORIGINS=https://postula.develam.com.ar

# Credenciales de Google OAuth (OAuth consent screen → OAuth Client ID tipo "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=